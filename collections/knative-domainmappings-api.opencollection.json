              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a DomainMapping to associate a custom domain name with a Knative Service. Knative will handle TLS certificate provisioning via cert-manager or another configured certificate provider."
        },
        {
          "info": {
            "name": "Knative Get a DomainMapping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kubernetes.default.svc/apis/serving.knative.dev/v1alpha1/namespaces/:namespace/domainmappings/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace containing the resource."
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the Knative resource."
              }
            ]
          },
